# Application
NODE_ENV=development
PORT=3000
APP_NAME=OfficeX API
API_PREFIX=api
API_VERSION=v1

# Database (MongoDB)
DATABASE_URL=mongodb://127.0.0.1:27017/officex_db?replicaSet=rs0

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# MinIO (S3-compatible Object Storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=officex_minio
MINIO_SECRET_KEY=officex_minio_password
MINIO_BUCKET_DOCUMENTS=documents
MINIO_BUCKET_ASSETS=assets

# Throttle (Rate Limiting)
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:5175,http://localhost:5180,http://localhost:5181

# AI (Optional)
OPENAI_API_KEY=
GEMINI_API_KEY=
